@page "/Dash"
@model SWP391_M2_BL5_G4_SP25.Pages.Client_Dash.DashboardModel
@{
    ViewData["Title"] = "Employer Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Employer Dashboard for Jobpath">
    <meta name="keywords" content="Job, Employer, Dashboard">
    <link rel="shortcut icon" href="/assets/img/favicon.ico" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/assets/fonts/icon/css/rt_Denns.css">
    <link rel="stylesheet" href="/assets/fonts/fontawesome/css/all.min.css">
    <link rel="stylesheet" href="/assets/css/plugins.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <title>@ViewData["Title"]</title>
</head>
<body class="template">
    <!-- Header -->
    <header class="rts_section rts_dashboard_header position-fixed w-100">
        <div class="container-fluid g-0">
            <div class="rts_menu_background mw-100 px-20 mobile_padding rounded-0">
                <div class="row">
                    <div class="d-flex align-items-center justify-content-between">
                        <div class="rts_logo">
                            <a href="/">
                                <img class="logo_image" src="/assets/img/logo/header_one.svg" width="160" height="40" alt="logo">
                            </a>
                        </div>
                        <div class="navigation d-none d-lg-block">
                            <nav class="navigation_menu">
                                <ul class="list-unstyled">
                                    <li class="navigation_menu-item"><a href="/" class="navigation_menu-item_link">Home</a></li>
                                    <li class="navigation_menu-item"><a href="/Jobs" class="navigation_menu-item_link">Browse Jobs</a></li>
                                    <li class="navigation_menu-item"><a href="/Candidates" class="navigation_menu-item_link">Candidates</a></li>
                                    <li class="navigation_menu-item"><a href="/About" class="navigation_menu-item_link">About</a></li>
                                    <li class="navigation_menu-item"><a href="/Contact" class="navigation_menu-item_link">Contact</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content -->
    <main class="rts_dashboard_main pt-5">
        <div class="container">
            <!-- Overview Section -->
            <div class="overview_wrapper mb-4">
                <h3>Overview</h3>
                <div class="row">
                    <div class="col-md-3">
                        <div class="card text-center p-3 shortlist_wrapper">
                            <i class="fas fa-briefcase fa-2x text-primary"></i>
                            <h3>@Model.Dashboard.OpenJobsCount</h3>
                            <p>Open Jobs</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center p-3 shortlist_wrapper">
                            <i class="fas fa-file-alt fa-2x text-success"></i>
                            <h3>@Model.Dashboard.TotalApplications</h3>
                            <p>Total Applications</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center p-3 shortlist_wrapper">
                            <i class="fas fa-user-check fa-2x text-warning"></i>
                            <h3>@Model.Dashboard.ShortlistedCount</h3>
                            <p>Shortlisted Candidates</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card text-center p-3 shortlist_wrapper">
                            <i class="fas fa-eye fa-2x text-info"></i>
                            <h3>@Model.Dashboard.TotalJobViews</h3>
                            <p>Job Views</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <!-- Left Column: Jobs and Shortlisted Candidates -->
                <div class="col-lg-8">
                    <!-- Posted Jobs Section -->
                    <div class="posted_jobs_wrapper mb-4">
                        <h3>Posted Jobs</h3>
                        <div class="shortlist_wrapper">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>Title</th>
                                        <th>Location</th>
                                        <th>Salary</th>
                                        <th>Applications</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                               @*  <tbody>
                                    @foreach (var job in Model.Dashboard.Jobs)
                                    {
                                        <tr>
                                            <td>@job.Title</td>
                                            <td>@job.Location</td>
                                            <td>@job.Salary</td>
                                            <td>@job.JobApplications.Count</td> 
                                            <td>
                                                <a href="/Jobs/Details/@job.ID" class="btn btn-sm btn-primary">View</a>
                                                <a href="/Jobs/Edit/@job.ID" class="btn btn-sm btn-warning">Edit</a>
                                                <form asp-page-handler="CloseJob" method="post" style="display:inline;">
                                                    <input type="hidden" name="jobId" value="@job.ID" />
                                                    <button type="submit" class="btn btn-sm btn-danger">Close</button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody> *@
                            </table>
                        </div>
                    </div>

                    <!-- Shortlisted Candidates Section -->
                 @*    <div class="shortlist_wrapper">
                        <h3>Shortlisted Candidates</h3>
                        @foreach (var application in Model.Dashboard.ShortlistedApplications)
                        {
                            <div class="single_shortlist_item">
                                <div class="author_info">
                                    <div class="author__meta">
                                        <div class="author_image">
                                            <img src="/assets/img/author/@application.JobSeekerProfile.ID.svg" alt="author">
                                        </div>
                                        <div class="author_name">
                                            <h6 class="fw-semibold mb-1">@application.JobSeekerProfile.FullName</h6>
                                            <p class="mb-0">@application.Job.Title</p>
                                        </div>
                                    </div>
                                    <div class="author_info_list">
                                        <span><i class="fa-light fa-clock"></i> @application.ApplicationDate.ToString("MMM dd, yyyy")</span>
                                        <button class="action_click">@application.Status</button>
                                    </div>
                                </div>
                                <div class="shortlist_action">
                                    <button class="action_item_long" onclick="createMeeting(@application.ID)">
                                        <svg width="18" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M16 2H14V0H12V2H6V0H4V2H2C0.9 2 0 2.9 0 4V14C0 15.1 0.9 16 2 16H16C17.1 16 18 15.1 18 14V4C18 2.9 17.1 2 16 2ZM16 14H2V6H16V14ZM2 4V5H16V4H2ZM4 8H6V10H4V8ZM8 8H10V10H8V8ZM12 8H14V10H12V8Z" fill="#939393"/>
                                        </svg>
                                        Create Meeting
                                    </button>
                                    <a href="@application.JobSeekerProfile.CVUrl" class="action_item_long" download>
                                        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" xmlns="http://www.w3.org/2000/svg">
                                            <path d="M16 0H2C0.9 0 0 0.9 0 2V16C0 17.1 0.9 18 2 18H16C17.1 18 18 17.1 18 16V2C18 0.9 17.1 0 16 0ZM16 16H2V2H16V16ZM8 14H10V10H14L9 5L4 10H8V14Z" fill="#939393"/>
                                        </svg>
                                        Download CV
                                    </a>
                                    <form asp-page-handler="DeleteApplication" method="post" style="display:inline;">
                                        <input type="hidden" name="applicationId" value="@application.ID" />
                                        <button type="submit" class="action_item">
                                            <svg width="20" height="22" viewBox="0 0 20 22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M1 5H3H19H20V7H19V20C19 21.1 18.1 22 17 22H3C1.9 22 1 21.1 1 20V7H0V5H1ZM3 20H17V7H3V20ZM7 2V0H13V2H7Z" fill="#FF5757"/>
                                            </svg>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                    </div>
                </div> *@

                <!-- Right Column: Notifications and Chart -->
                <div class="col-lg-4">
                    <!-- Notifications Section -->
                    @* <div class="notification_body mb-4">
                        <h3>Notifications</h3>
                        @foreach (var notification in Model.Dashboard.Notifications)
                        {
                            <div class="single_notification">
                                <div class="notification_image">
                                    <img src="/assets/img/author/@notification.UserId.svg" alt="author">
                                </div>
                                <div class="notification_content">
                                    <p>@notification.Message</p>
                                </div>
                                <div class="time">
                                    <span>@notification.CreatedDate.ToString("MMM dd, yyyy HH:mm")</span>
                                </div>
                            </div>
                        }
                    </div>
 *@
                    <!-- Recruitment Performance Chart -->
                    <div class="chart_wrapper">
                        <h3>Recruitment Performance</h3>
                        <canvas id="applicationsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="rts_footer mt-5">
        <div class="container text-center">
            <p class="font-20 fw-medium text-decoration-underline">Our Social Links</p>
            <div class="rts_social d-flex justify-content-center gap-3 mt-3">
                <a target="_blank" href="https://facebook.com/" aria-label="facebook">
                    <i class="fa-brands fa-facebook"></i>
                </a>
                <a target="_blank" href="https://instagram.com/" aria-label="instagram">
                    <i class="fa-brands fa-instagram"></i>
                </a>
                <a target="_blank" href="https://linkedin.com/" aria-label="linkedin">
                    <i class="fa-brands fa-linkedin"></i>
                </a>
                <a target="_blank" href="https://pinterest.com/" aria-label="pinterest">
                    <i class="fa-brands fa-pinterest"></i>
                </a>
                <a target="_blank" href="https://youtube.com/" aria-label="youtube">
                    <i class="fa-brands fa-youtube"></i>
                </a>
            </div>
        </div>
    </footer>

    <!-- Preloader -->
    <div class="loader-wrapper">
        <div class="loader"></div>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
    </div>

    <!-- Back to Top -->
    <button type="button" class="rts_back_top" id="rts-back-to-top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- Scripts -->
    <script src="/assets/js/plugins.min.js"></script>
    <script src="/assets/js/main.js"></script>
