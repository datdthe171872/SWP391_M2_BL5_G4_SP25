@page "/Admin"
@model SWP391_M2_BL5_G4_SP25.Pages.Client_Dash.AdminDashModel
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="Admin Dashboard for Jobpath">
    <meta name="keywords" content="dashboard, jobpath, admin">
    <meta name="author" content="Your Name">
    <title>Admin Dashboard - Jobpath</title>
    <link rel="icon" type="image/png" href="assets/images/favicon.png">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/assets/css/fontawesome.min.css">
    <link rel="stylesheet" href="/assets/css/rt-icons.css">
    <link rel="stylesheet" href="/assets/css/plugins.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <style>
        .chart-container {
            position: relative;
            width: 100%;
            height: 400px;
        }
        canvas {
            width: 100% !important;
            height: 100% !important;
        }
        .filter-form {
            margin-bottom: 20px;
        }
        .filter-form select {
            margin-right: 10px;
            padding: 5px;
        }
    </style>
</head>

<body>
    @await Html.PartialAsync("_Header",Model.Header)

    <div class="dashboard__content d-flex">
        <!-- Sidebar -->
        @await Html.PartialAsync("_NavAdmin")

        <!-- Main Content -->
        <div class="dashboard__right">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">
                    @Model.ErrorMessage
                </div>
            }
            else if (Model.IsLoading)
            {
                <p>Loading...</p>
            }
            else
            {
                <div>
                    <p><strong>Total Jobs:</strong> @Model.JobCount</p>
                    <p><strong>Total Companies:</strong> @Model.CompanyCount</p>

                    <canvas id="dailyChart" width="400" height="200"></canvas>
                    <canvas id="monthlyChart" width="400" height="200" style="margin-top:30px;"></canvas>
                </div>

                <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

             
            }
        </div>
    </div>

    <script src="/assets/js/plugins.min.js"></script>
    <script src="/assets/js/main.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            try {
                // Daily Chart
                const dailyLabels = [@(string.Join(",", Model.DailyApplications.Keys.Select(k => $"'{k}'")))];
                const dailyData = [@(string.Join(",", Model.DailyApplications.Values))];
                console.log("Daily Chart Data:", dailyLabels, dailyData); // Debug
                new Chart(document.getElementById('dailyChart'), {
                    type: 'line',
                    data: {
                        labels: dailyLabels,
                        datasets: [{
                            label: 'Job Applications',
                            data: dailyData,
                            borderColor: '#007bff',
                            fill: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });

                // Monthly Chart
                const monthlyLabels = [@(string.Join(",", Model.MonthlyApplications.Keys.Select(k => $"'{k}'")))];
                const monthlyData = [@(string.Join(",", Model.MonthlyApplications.Values))];
                console.log("Monthly Chart Data:", monthlyLabels, monthlyData); // Debug
                new Chart(document.getElementById('monthlyChart'), {
                    type: 'line',
                    data: {
                        labels: monthlyLabels,
                        datasets: [{
                            label: 'Job Applications',
                            data: monthlyData,
                            borderColor: '#28a745',
                            fill: false
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            y: { beginAtZero: true }
                        }
                    }
                });
            } catch (error) {
                console.error("Error initializing charts:", error);
            }
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Nhận dữ liệu từ server
        var dailyData = @Html.Raw(Json.Serialize(Model.DailyApplications));
        var monthlyData = @Html.Raw(Json.Serialize(Model.MonthlyApplications));

        // Chart 1: Applications by Day
        var ctxDaily = document.getElementById('dailyChart').getContext('2d');
        new Chart(ctxDaily, {
            type: 'line',
            data: {
                labels: Object.keys(dailyData),
                datasets: [{
                    label: 'Applications per Day',
                    data: Object.values(dailyData),
                    borderColor: 'rgba(75, 192, 192, 1)',
                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });

        // Chart 2: Applications by Month
        var ctxMonthly = document.getElementById('monthlyChart').getContext('2d');
        new Chart(ctxMonthly, {
            type: 'bar',
            data: {
                labels: Object.keys(monthlyData),
                datasets: [{
                    label: 'Applications per Month',
                    data: Object.values(monthlyData),
                    backgroundColor: 'rgba(153, 102, 255, 0.6)',
                    borderColor: 'rgba(153, 102, 255, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true
                    }
                }
            }
        });
    </script>
</body>
</html>