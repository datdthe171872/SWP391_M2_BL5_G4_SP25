@page
@model SWP391_M2_BL5_G4_SP25.Pages.Client.UpdateJobModel
@{
}
<!DOCTYPE html>
<html lang="en">

<!-- Mirrored from html.themewant.com/jobpath/template/employer-dash-jobpost.html by HTTrack Website Copier/3.x [XR&CO'2014], Tue, 15 Apr 2025 22:11:51 GMT -->
<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="Your Ultimate Job HTML Template">
    <meta name="keywords" content="Job, Resume, Employer, Agency">
    <link rel="canonical" href="https://html.themewant.com/jobpath">
    <meta name="robots" content="index, follow">
    <!-- for open graph social media -->
    <meta property="og:title" content="Your Ultimate Job HTML Template">
    <meta property="og:description" content="Your Ultimate Job HTML Template">
    <meta property="og:image" content="../../../www.example.com/image.html">
    <meta property="og:url" content="https://html.themewant.com/jobpath/">
    <!-- for twitter sharing -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Your Ultimate Job HTML Template">
    <meta name="twitter:description" content="Your Ultimate Job HTML Template">
    <!-- fabicon -->
    <link rel="shortcut-icon" href="/assets/img/favicon-16x16.png" type="image/x-icon">



    <link rel="preconnect" href="https://fonts.googleapis.com/">
    <link rel="preconnect" href="https://fonts.gstatic.com/" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&amp;display=swap" rel="stylesheet">
    <link rel="shortcut icon" href="/assets/img/favicon.ico" type="image/x-icon">
    <title>Jobpath - Job Seeker &amp; Job Holder HTML Template</title>
    <!-- rt icons -->
    <link rel="stylesheet" href="/assets/fonts/icon/css/rt-icons.css">
    <!-- fontawesome -->
    <link rel="stylesheet" href="/assets/fonts/fontawesome/fontawesome.min.css">
    <!-- all plugin css -->
    <link rel="stylesheet" href="/assets/css/plugins.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">

</head>
<body class="template-dashboard">
    <!-- header area -->
    @await Html.PartialAsync("_Header")
    <!-- header area end -->
    <!-- content area -->
    <div class="dashboard__content d-flex">
        @await Html.PartialAsync("_NavClient")
        <div class="dashboard__right">
            <div class="dash__content ">
                <!-- sidebar menu -->
                <div class="sidebar__menu d-md-block d-lg-none">
                    <div class="sidebar__action"><i class="fa-sharp fa-regular fa-bars"></i> Sidebar</div>
                </div>
                <!-- sidebar menu end -->

                <h6 class="fw-medium mt-4 mb-4">Create Job</h6>
                <form method="post">
                    <input type="text" asp-for="Input.JobId" value="@Model.JobId" hidden readonly />
                    <div class="my__profile__tab radius-16 bg-white">
                        <nav>
                            <div class="nav nav-tabs">
                                <a class="nav-link active">Details</a>
                            </div>
                        </nav>
                        <br />
                        <br />
                        <div class="my__details" id="info">
                            <div class="info__field">
                                <div class="row row-cols-sm-2 row-cols-1 g-3">
                                    <!-- Company-->
                                    <div class="rt-input-group">
                                        <label for="cname">Company Name</label>

                                        <select class="form-select" asp-for="Input.Company">
                                            @if (Model.Companies.Count == 0)
                                            {
                                                <option value="">No Company Found</option>
                                            }
                                            @foreach (var company in Model.Companies)
                                            {
                                                <option value="@company.CompanyID">@company.CompanyName</option>
                                            }

                                        </select>
                                    </div>
                                    <!-- Title-->
                                    <div class="rt-input-group">
                                        <label for="jt">Job Title</label>
                                        <input type="text" id="jt" placeholder="Software Engineer" asp-for="Input.Title" required>
                                    </div>
                                </div>

                                <div class="row row-cols-1">
                                    <!-- Desctiption-->
                                    <div class="rt-input-group">
                                        <label for="jd">Job Description</label>
                                        <textarea id="jd" placeholder="Enter Job Description" required asp-for="Input.Description"></textarea>
                                    </div>
                                </div>

                                <div class="row row-cols-sm-2 row-cols-1 g-3">
                                    <!-- Category-->
                                    <div class="rt-input-group">
                                        <label for="ws">Category</label>
                                        <select id="ws" class="form-select" asp-for="Input.Category">
                                            @foreach (var cate in Model.Categories)
                                            {
                                                <option value="@cate.JobCategoryID">@cate.CategoryName</option>
                                            }
                                        </select>
                                    </div>
                                    <!-- Job type-->
                                    <div class="rt-input-group">
                                        <label for="wd">Job Type</label>
                                        <select asp-for="Input.Jobtype" id="wd" class="form-select">
                                            <option value="Full-time">Full-time</option>
                                            <option value="Part-time">Part-time</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="row row-cols-sm-2 row-cols-1 g-3">
                                    <!-- Exp-->
                                    <div class="rt-input-group">
                                        <label for="hp">Experience</label>
                                        <input type="text" id="jt" placeholder="Enter Experience" asp-for="Input.Exp" required>
                                    </div>
                                    <!-- Salary-->
                                    <div class="rt-input-group">
                                        <label for="salary">Salary</label>
                                        <input type="number" min="0" id="jt" placeholder="Enter Salary" asp-for="Input.Salary" required>
                                    </div>
                                </div>
                                <!-- Location-->
                                <div class="row row-cols-1">
                                    <div class="rt-input-group">
                                        <label for="jd">Location</label>
                                        <input id="jd" placeholder="Enter Location" required asp-for="Input.Location">
                                    </div>
                                </div>
                                <!-- Skill-->
                                <div class="row row-cols-1">
                                    <div class="rt-input-group">
                                        <label for="jd">Skill Required</label>
                                        <input id="jd" placeholder="Enter Skill" required asp-for="Input.Skill">
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>

                    <!-- Requirement -->
                    <h6 class="fw-medium mt-4 mb-4">Requirements</h6>
                    <div class="social__links p-30 radius-16 bg-white" id="member">
                        <div class="accordion">
                            <div id="requirements">
                                @for(int i = 0; i < Model.Requirements.Count; i++){
                                    <div class="accordion-item">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#requirement@(Model.Requirements[i].RequirementID)" aria-expanded="false" aria-controls="${uniqueId}">
                                            Requirement
                                        </button>
                                        <div id="requirement@(Model.Requirements[i].RequirementID)" class="accordion-collapse collapse" data-bs-parent="#requirement@(Model.Requirements[i].RequirementID)">
                                            <div class="accordion-body mt-20 mb-20">
                                                <div class="info__field">
                                                    <div class="rt-input-group">
                                                        <input type="hidden" name="Input.Requirements[@i].Id" value="@Model.Requirements[i].RequirementID" readonly />
                                                        <textarea name="Input.Requirements[@i].Content" cols="30" rows="5" placeholder="Content" class="form-control" required>@Model.Requirements[i].Content</textarea>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end mt-3">
                                                    <button type="button" class="added__social__link" onclick="removeField(this)">Remove</button>
                                                </div>
                                            </div>
                                        </div>
                                        <br>
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-start">
                                <button class="added__social__link" type="button" onclick="addRequirement()">Add Requirement </button>
                            </div>
                        </div>
                    </div>
                    <!-- Requirement end-->
                    <!-- Responsibilities -->
                    <h6 class="fw-medium mt-4 mb-4">Responsibilities</h6>
                    <div class="social__links p-30 radius-16 bg-white" id="member">
                        <div class="accordion">
                            <div id="responsibilities">
                                @for (int i = 0; i < Model.Responsibilities.Count; i++)
                                {
                                    <div class="accordion-item">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#res@(Model.Responsibilities[i].ResponsibilityID)" aria-expanded="false" aria-controls="${uniqueId}">
                                            Responsibility
                                        </button>
                                        <div id="res@(Model.Responsibilities[i].ResponsibilityID)" class="accordion-collapse collapse" data-bs-parent="#res@(Model.Responsibilities[i].ResponsibilityID)">
                                            <div class="accordion-body mt-20 mb-20">
                                                <div class="info__field">
                                                    <div class="rt-input-group">
                                                        <input type="hidden" name="Input.Responsibilities[@i].Id" value="@Model.Responsibilities[i].ResponsibilityID" readonly />
                                                        <textarea name="Input.Responsibilities[@i].Content" cols="30" rows="5" placeholder="Content" class="form-control" required>@Model.Responsibilities[i].Content</textarea>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end mt-3">
                                                    <button type="button" class="added__social__link" onclick="removeField(this)">Remove</button>
                                                </div>
                                            </div>
                                        </div>
                                        <br>
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-start">
                                <button class="added__social__link" type="button" onclick="addResponsibility()">Add Responsibility</button>
                            </div>
                        </div>
                    </div>
                    <!-- Responsibilities end-->
                    <!-- Benefits -->

                    <h6 class="fw-medium mt-4 mb-4">Benefits</h6>
                    <div class="social__links p-30 radius-16 bg-white" id="member">
                        <div class="accordion">
                            <div id="benefits">
                                @for (int i = 0; i < Model.Benefits.Count; i++)
                                {
                                    <div class="accordion-item">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#benefit@(Model.Benefits[i].BenefitID)" aria-expanded="false" aria-controls="${uniqueId}">
                                            Benefit
                                        </button>
                                        <div id="benefit@(Model.Benefits[i].BenefitID)" class="accordion-collapse collapse" data-bs-parent="#benefit@(Model.Benefits[i].BenefitID)">
                                            <div class="accordion-body mt-20 mb-20">
                                                <div class="info__field">
                                                    <div class="rt-input-group">
                                                        <input type="hidden" name="Input.Benefits[@i].Id" value="@Model.Benefits[i].BenefitID" readonly />
                                                        <textarea name="Input.Benefits[@i].Content" cols="30" rows="5" placeholder="Content" class="form-control" required>@Model.Benefits[i].Content</textarea>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end mt-3">
                                                    <button type="button" class="added__social__link" onclick="removeField(this)">Remove</button>
                                                </div>
                                            </div>
                                        </div>
                                        <br>
                                    </div>
                                }
                            </div>
                            <div class="d-flex justify-content-start">
                                <button class="added__social__link" type="button" onclick="addBenefit()">Add Benefit</button>
                            </div>
                        </div>
                    </div>
                    <!-- Benefits end-->
                    <br>
                    <button type="submit" class="small__btn d-none d-sm-flex d-xl-flex fill__btn border-6 font-xs">Update Job</button>
                    <div class="form-group text-danger" asp-validation-summary="ModelOnly">
                    </div>
                </form>
            </div>
            <div class="d-flex justify-content-center mt-30">
                <p class="copyright">Copyright © 2024 All Rights Reserved by jobpath</p>
            </div>
        </div>
    </div>
    <!-- content area end -->
    <!-- THEME PRELOADER START -->
    <div class="loader-wrapper">
        <div class="loader">
        </div>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
    </div>
    <!-- THEME PRELOADER END -->
    <button type="button" class="rts__back__top" id="rts-back-to-top">
        <i class="fas fa-arrow-up"></i>
    </button>
    <!-- all plugin js -->
    <script src="/assets/js/plugins.min.js"></script>
    <script src="/assets/js/main.js"></script>
    <script>
        var requirementCount = 0;
        var responsibilitiyCount = 0;
        var benefitCount = 0;
        function addRequirement() {
            requirementCount++;

            var div = document.getElementById("requirements");
            var index = div.children.length;
            var uniqueId = "collapseRequirement" + requirementCount;
            var accordionItem = document.createElement("div");
            accordionItem.className = "accordion-item";

            accordionItem.innerHTML = `
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#${uniqueId}" aria-expanded="false" aria-controls="${uniqueId}">
                                            Requirement
                                        </button>
                                        <div id="${uniqueId}" class="accordion-collapse collapse" data-bs-parent="#requirements">
                                            <div class="accordion-body mt-20 mb-20">
                                                <div class="info__field">
                                                    <div class="rt-input-group">
                                                        <input type="hidden" name="Input.Requirements[${index}].Id" value="0" />
                                                        <textarea name="Input.Requirements[${index}].Content" cols="30" rows="5" placeholder="Content" class="form-control" required></textarea>
                                                    </div>
                                                </div>
                                                <div class="d-flex justify-content-end mt-3">
                                                            <button type="button" class="added__social__link" onclick="removeField(this)">Remove</button>
                                                </div>
                                            </div>
                                        </div>
                                        <br>
                                `;

            div.appendChild(accordionItem);
        }


        function addResponsibility() {
            responsibilitiyCount++;
            var div = document.getElementById("responsibilities")
            var index = div.children.length;
            var uniqueId = "collapseRes" + responsibilitiyCount;
            var accordionItem = document.createElement("div");
            accordionItem.className = "accordion-item";
            accordionItem.innerHTML = `<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#${uniqueId}" aria-expanded="false" aria-controls="${uniqueId}">
                                                            Responsibility
                                                </button>
                                                <div id="${uniqueId}" class="accordion-collapse collapse" data-bs-parent="#requirements">
                                                    <div class="accordion-body mt-20 mb-20">
                                                        <div class="info__field">
                                                            <div class="rt-input-group">
                                                                        <input type="hidden" name="Input.Responsibilities[${index}].Id" value="0" />
                                                                                <textarea name="Input.Responsibilities[${index}].Content" cols="30" rows="5" placeholder="Content" class="form-control" required></textarea>
                                                            </div>
                                                        </div>
                                                        <div class="d-flex justify-content-end mt-3">
                                                                    <button type="button" class="added__social__link" onclick="removeField(this)">Remove</button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <br>`;
            div.appendChild(accordionItem);
        }

        function addBenefit() {
            benefitCount++;
            var div = document.getElementById("benefits")
            var index = div.children.length;
            var uniqueId = "collapseBenefit" + responsibilitiyCount;
            var accordionItem = document.createElement("div");
            accordionItem.className = "accordion-item";
            accordionItem.innerHTML = `<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#${uniqueId}" aria-expanded="false" aria-controls="${uniqueId}">
                                                                    Benefit
                                                        </button>
                                                        <div id="${uniqueId}" class="accordion-collapse collapse" data-bs-parent="#requirements">
                                                            <div class="accordion-body mt-20 mb-20">
                                                                <div class="info__field">
                                                                    <div class="rt-input-group">
                                                                                        <input type="hidden" name="Input.Benefits[${index}].Id" value="0" />
                                                                                                <textarea name="Input.Benefits[${index}].Content" cols="30" rows="5" placeholder="Content" class="form-control" required></textarea>
                                                                    </div>
                                                                </div>
                                                                <div class="d-flex justify-content-end mt-3">
                                                                            <button type="button" class="added__social__link" onclick="removeField(this)">Remove</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <br>`;
            div.appendChild(accordionItem);
        }


        function removeField(button) {
            button.closest(".accordion-item").remove();
        }
    </script>
</body>

