@page "{id:int?}"
@model SWP391_M2_BL5_G4_SP25.Pages.Admin.UserProfile.IndexModel
@{
}
<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-8">
      @if (!string.IsNullOrEmpty(TempData["StatusMessage"]?.ToString()))
      {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
          @TempData["StatusMessage"]
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      }

      <div class="card shadow-sm">
        <div class="card-header bg-primary text-white py-3">
          <h4 class="mb-0">User Profile</h4>
        </div>
        <div class="card-body">
          <form method="post">
            <input type="hidden" asp-for="UserProfile.Id" />

            <div class="row mb-3">
              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label asp-for="UserProfile.FullName" class="form-label fw-medium"></label>
                  <input asp-for="UserProfile.FullName" class="form-control" />
                  <span asp-validation-for="UserProfile.FullName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                  <label asp-for="UserProfile.Email" class="form-label fw-medium"></label>
                  <input asp-for="UserProfile.Email" class="form-control" />
                  <span asp-validation-for="UserProfile.Email" class="text-danger"></span>
                </div>
              </div>

              <div class="col-md-6">
                <div class="form-group mb-3">
                  <label asp-for="UserProfile.PhoneNumber" class="form-label fw-medium"></label>
                  <input asp-for="UserProfile.PhoneNumber" class="form-control" />
                  <span asp-validation-for="UserProfile.PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                  <label asp-for="UserProfile.Address" class="form-label fw-medium"></label>
                  <input asp-for="UserProfile.Address" class="form-control" />
                  <span asp-validation-for="UserProfile.Address" class="text-danger"></span>
                </div>
              </div>
            </div>

            <div class="d-flex justify-content-end mt-4">
              <button type="submit" class="btn btn-primary">
                <i class="fa fa-save me-2"></i>Save Changes
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}