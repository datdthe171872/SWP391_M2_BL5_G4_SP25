@page
@model SWP391_M2_BL5_G4_SP25.Pages.Admin.Category.CreateModel
@{
}
<div class="row">
	<div class="col-md-8 offset-md-2">
		<div class="card">
			<div class="card-header">
				<h4>Create New Category</h4>
			</div>
			<div class="card-body">
				<form method="post">
					<div class="form-group mb-3">
						<label asp-for="Input.CategoryName"></label>
						<input asp-for="Input.CategoryName" class="form-control" />
						<span asp-validation-for="Input.CategoryName" class="text-danger"></span>
					</div>

					<div class="form-group mb-3">
						<label asp-for="Input.Description"></label>
						<input asp-for="Input.Description" class="form-control" />
						<span asp-validation-for="Input.Description" class="text-danger"></span>
					</div>

					<div class="form-group">
						<button type="submit" class="btn btn-success">Create</button>
						<a asp-page="/Admin/Category/Index" class="btn btn-secondary">Cancel</a>
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<partial name="_ValidationScriptsPartial" />
}