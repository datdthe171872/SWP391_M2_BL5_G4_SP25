@page "/Jobs/Details"
@model SWP391_M2_BL5_G4_SP25.Pages.Jobs.DetailsModel
@{
    ViewData["Title"] = Model.JobDetail.Title;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="@Model.JobDetail.Title">
    <meta name="keywords" content="Job, @Model.JobDetail.CategoryName">
    <link rel="shortcut-icon" href="/assets/img/favicon-16x16.png" type="image/x-icon">
    <title>@ViewData["Title"] - Jobpath</title>
    <link rel="stylesheet" href="/assets/fonts/icon/css/rt-icons.css">
    <link rel="stylesheet" href="/assets/fonts/fontawesome/fontawesome.min.css">
    <link rel="stylesheet" href="/assets/css/plugins.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>
    <!-- Header -->
    @await Html.PartialAsync("_Header", Model.Header)

    <!-- Breadcrumb -->
    <div class="rts__section breadcrumb__background">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 position-relative d-flex justify-content-between align-items-center">
                    <div class="breadcrumb__area max-content mx-auto breadcrumb__padding">
                        <div class="rts__job__card__big bg-transparent p-0 position-relative z-1 flex-wrap justify-content-center d-flex gap-4 align-items-center">
                            <div>
                                <div class="job__meta w-100 d-flex text-center text-md-start flex-column gap-2">
                                    <h3 class="job__title text-center h3 mb-0">@Model.JobDetail.Title, @Model.JobDetail.CompanyName</h3>
                                    <div class="d-flex gap-4 justify-content-center justify-content-md-start flex-wrap mb-3 mt-2">
                                        <div class="d-flex gap-2 align-items-center">
                                            <i class="fa-light fa-location-dot"></i> @Model.JobDetail.Location
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <i class="fa-light rt-briefcase"></i> @Model.JobDetail.JobType
                                        </div>
                                        <div class="d-flex gap-2 align-items-center">
                                            <i class="fa-light fa-clock"></i> @Model.JobDetail.PostDate.ToString("dd MMMM yyyy")
                                        </div>
                                        <div class="d-flex gap-2 fw-medium align-items-center">
                                            <i class="fa-light rt-price-tag"></i> $@Model.JobDetail.Salary / Monthly
                                        </div>
                                    </div>
                                    <div class="job__tags d-flex justify-content-center flex-wrap gap-3">
                                        <a href="#">@Model.JobDetail.CategoryName</a>
                                        @foreach (var skill in Model.JobDetail.Skills?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? new string[0])
                                        {
                                            <a href="#">@skill.Trim()</a>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="breadcrumb__area__shape breadcrumb__style__four d-flex gap-4 justify-content-end align-items-center">
                        <div class="shape__one common"><img src="/assets/img/breadcrumb/shape-1.svg" alt=""></div>
                        <div class="shape__two common"><img src="/assets/img/breadcrumb/shape-2.svg" alt=""></div>
                        <div class="shape__three common"><img src="/assets/img/breadcrumb/shape-3.svg" alt=""></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Job Details -->
    <div class="rts__section section__padding">
        <div class="container">
            <div class="row justify-content-center g-30">
                <div class="col-lg-8">
                    <div class="rts__job__details">
                        <div class="mb-30">
                            <img class="rounded-3" src="/assets/img/pages/job-details-4.webp" alt="Job Image">
                        </div>
                        <div class="job__overview style__four no-border-bottom mb-40">
                            <h6 class="fw-semibold mb-30">Job Overview</h6>
                            <div class="job__overview__content">
                                <ul class="d-grid grid-style">
                                    <li class="d-flex flex-column gap-3 gap-sm-0 align-items-center justify-content-between">
                                        <div class="d-flex gap-3">
                                            <span class="icon"><i class="rt-calender"></i></span>
                                            <div>
                                                <span class="left-text">Date Posted</span>
                                                <span class="text">@Model.JobDetail.PostDate.ToString("dd MMMM yyyy")</span>
                                            </div>
                                        </div>
                                    </li>
                                   
                                    <li class="d-flex flex-column gap-3 gap-sm-0 align-items-center justify-content-between">
                                        <div class="d-flex gap-3">
                                            <span class="icon"><i class="rt-experience"></i></span>
                                            <div>
                                                <span class="left-text">Experience</span>
                                                <span class="text">@Model.JobDetail.Exp</span>
                                            </div>
                                        </div>
                                    </li>
                                    <li class="d-flex flex-column gap-3 gap-sm-0 align-items-center justify-content-between">
                                        <div class="d-flex gap-3">
                                            <span class="icon"><i class="rt-price-tag"></i></span>
                                            <div>
                                                <span class="left-text">Offered Salary</span>
                                                <span class="text">$@Model.JobDetail.Salary / Monthly</span>
                                            </div>
                                        </div>
                                    </li>
                                  
                                    <li class="d-flex flex-column gap-3 gap-sm-0 align-items-center justify-content-between">
                                        <div class="d-flex gap-3">
                                            <span class="icon"><i class="rt-qualification"></i></span>
                                            <div>
                                                <span class="left-text">Qualification</span>
                                                <span class="text">@Model.JobDetail.SkillsRequired</span>
                                            </div>
                                        </div>
                                    </li>
                                    <li class="d-flex flex-column gap-3 gap-sm-0 align-items-center justify-content-between">
                                        <div class="d-flex gap-3">
                                            <span class="icon"><i class="fa-sharp fa-thin fa-location-dot"></i></span>
                                            <div>
                                                <span class="left-text">Location</span>
                                                <span class="text">@Model.JobDetail.Location</span>
                                            </div>
                                        </div>
                                    </li>
                                    <li class="d-flex flex-column gap-3 gap-sm-0 align-items-center justify-content-between">
                                        <div class="d-flex gap-3">
                                            <span class="icon"><i class="fa-light fa-user"></i></span>
                                            <div>
                                                <span class="left-text">Gender</span>
                                                <span class="text">@Model.JobDetail.Gender</span>
                                            </div>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div id="description" class="mb-30">
                            <h6 class="fw-semibold mb-20">Job Description</h6>
                            <p>@Model.JobDetail.Description</p>
                        </div>
                        <div id="requirements" class="mb-30">
                            <h6 class="fw-semibold mb-20">Requirements</h6>
                            <p>@Html.Raw(Model.JobDetail.Requirements)</p>
                        </div>
                        <div id="responsibilities" class="mb-30">
                            <h6 class="fw-semibold mb-20">Responsibilities</h6>
                            <p>@Html.Raw(Model.JobDetail.Responsibilities)</p>
                        </div>

                        <div id="skillsrequired" class="mb-30">
                            <h6 class="fw-semibold mb-20">Skill</h6>
                            <ul class="list-style-dot">
                                @foreach (var skillsrequired in Model.JobDetail.SkillsRequired?.Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? new string[0])
                                {
                                    <li>@skillsrequired.Trim()</li>
                                }
                            </ul>
                        </div>
                        <div id="skill" class="mb-30">
                            <h6 class="fw-semibold mb-20">Experience</h6>
                            <div class="job__tags job__details__tags">
                                @foreach (var skill in Model.JobDetail.Exp?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? new string[0])
                                {
                                    <a href="#" class="job__tag">@skill.Trim()</a>
                                }
                            </div>
                        </div>
                        @* <div id="salary" class="mb-30">
                        <h6 class="fw-semibold mb-20">Salary and Benefits</h6>
                        <ul class="list-style-dot">
                        @foreach (var salary in Model.JobDetail.Salary?.Split('\n', StringSplitOptions.RemoveEmptyEntries) ?? new int[0])
                        {
                        <li>@salary.Trim()</li>
                        }
                        </ul>
                        </div> *@
                        <div class="d-flex flex-wrap gap-4 mt-40 mb-60">
                            
                            @if (User.Identity.IsAuthenticated)
                            {
                                @if (User.IsInRole("JobSeeker"))
                                {
                                    <button type="button" class="rts__btn apply__btn fill__btn be-1 fw-bold" data-bs-toggle="modal" data-bs-target="#applyModal">
                                        Apply This Position
                                    </button>
                                    <!-- Modal -->
                                    <div class="modal fade" id="applyModal" tabindex="-1" aria-labelledby="applyModalLabel" aria-hidden="true">
                                        <div class="modal-dialog modal-lg">
                                            <div class="modal-content">
                                                <!-- Modal Header -->
                                                <div class="modal-header bg-primary text-white">
                                                    <h5 class="modal-title" id="applyModalLabel">Apply for @Model.JobDetail.Title</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>

                                                <!-- Modal Body -->
                                                <div class="modal-body">
                                                    <form method="post">
                                                        <!-- Hidden input for jobId -->
                                                        <input type="text" hidden readonly asp-for="JobId" value="@Model.JobDetail.JobID" />

                                                        <!-- Textarea for cover letter -->
                                                        @* <div class="mb-3">
                                                            <label for="coverletter" class="form-label fw-semibold">Cover Letter</label>
                                                            <textarea id="coverletter" name="coverletter" class="form-control" rows="4" placeholder="Write your cover letter here..." required></textarea>
                                                        </div> *@

                                                        <!-- Select box for uploaded CV links -->
                                                        <div class="mb-3">
                                                            <label for="cvLink" class="form-label fw-semibold">Select Your CV</label>
                                                            <select id="cvLink" name="cvLink" class="form-select" required>
                                                                <option value="" disabled selected>Select your CV</option>
                                                                @foreach (var resume in Model.UserResumes)
                                                                {
                                                                    <option value="@resume.Resumes.SingleOrDefault()?.Link">@resume.Resumes.SingleOrDefault()?.Link</option>
                                                                }
                                                            </select>
                                                        </div>

                                                        <!-- Submit button -->
                                                        <div class="text-end">
                                                            <button type="submit" class="btn btn-success btn-lg fw-bold">Submit Application</button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <a href="/Error" class="rts__btn apply__btn fill__btn be-1 fw-bold">
                                        Apply This Position
                                    </a>
                                }

                            }else{
                                <a href="/Account/Login" class="rts__btn apply__btn fill__btn be-1 fw-bold">
                                    Apply This Position
                                </a>
                            }
                            

                            

                            <a href="#" class="rts__btn apply__btn fill__btn be-1 fw-bold">Apply This Position</a>
                            <a href="/Company/Details/@Model.JobDetail.CompanyID" class="rts__btn apply__btn fill__btn be-1 fw-bold">View Company</a>
                            <div class="d-flex gap-3 align-items-center">
                                <span class="h6 fw-semibold">Share</span>
                                <div class="rts__social d-flex gap-3">
                                    <a target="_blank" href="https://facebook.com/" aria-label="facebook"><i class="fa-brands fa-facebook"></i></a>
                                    <a target="_blank" href="https://instagram.com/" aria-label="instagram"><i class="fa-brands fa-instagram"></i></a>
                                    <a target="_blank" href="https://linkedin.com/" aria-label="linkedin"><i class="fa-brands fa-linkedin"></i></a>
                                    <a target="_blank" href="https://pinterest.com/" aria-label="pinterest"><i class="fa-brands fa-pinterest"></i></a>
                                    <a target="_blank" href="https://youtube.com/" aria-label="youtube"><i class="fa-brands fa-youtube"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="form-group text-danger" asp-validation-summary="ModelOnly">
                    </div>
                    <div class="job__location__map">
                        <h5 class="fw-semibold mb-30">Location</h5>
                        <div class="gmap">
                            <iframe src="https://maps.google.com/maps?width=100%25&height=600&hl=en&q=@Model.JobDetail.Location&t=&z=14&ie=UTF8&iwloc=B&output=embed"></iframe>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer (giữ nguyên như template) -->
    <footer class="rts__section footer__home__one">
        <div class="container">
            <div class="row">
                <div class="footer__wrapper d-flex flex-wrap flex-column flex-sm-row gap-4 gap-md-0 gap-sm-3 justify-content-between pt-60 pb-60">
                    <div class="rts__footer__widget max-320">
                        <a href="/" class="footer__logo" aria-label="logo">
                            <img src="/assets/img/logo/header__one.svg" width="160" height="40" alt="logo">
                        </a>
                        <p class="mt-4">Whether you're an experienced professional or a fresh graduate eager to dive into the workforce, we have something for everyone.</p>
                    </div>
                    <div class="rts__footer__widget max-content">
                        <div class="font-20 fw-medium mb-3 h6">Links</div>
                        <ul class="list-unstyled">
                            <li><a href="/Jobs" aria-label="footer__menu__link">Browse Jobs</a></li>
                            <li><a href="#" aria-label="footer__menu__link">Browse Candidates</a></li>
                            <li><a href="#" aria-label="footer__menu__link">Blog & News</a></li>
                            <li><a href="#" aria-label="footer__menu__link">FAQ Question</a></li>
                            <li><a href="#" aria-label="footer__menu__link">Job Alerts</a></li>
                        </ul>
                    </div>
                    <div class="rts__footer__widget max-content">
                        <div class="font-20 fw-medium mb-3 h6">Contact Us</div>
                        <ul class="list-unstyled mb-3">
                            <li><a href="#"><i class="fa-light fa-location-dot"></i>2715 Ash Dr. San Jose, USA</a></li>
                            <li><a href="callto:+880171234578"><i class="fa-light fa-phone"></i>+(61) 545-432-234</a></li>
                            <li><a href="mailto:jobpath@gmail.com"><i class="fa-light fa-envelope"></i>jobpath@gmail.com</a></li>
                        </ul>
                        <div class="font-20 fw-medium mb-20 text-dark">Social Link</div>
                        <div class="rts__social d-flex gap-4">
                            <a target="_blank" href="https://facebook.com/" aria-label="facebook"><i class="fa-brands fa-facebook"></i></a>
                            <a target="_blank" href="https://instagram.com/" aria-label="instagram"><i class="fa-brands fa-instagram"></i></a>
                            <a target="_blank" href="https://linkedin.com/" aria-label="linkedin"><i class="fa-brands fa-linkedin"></i></a>
                            <a target="_blank" href="https://pinterest.com/" aria-label="pinterest"><i class="fa-brands fa-pinterest"></i></a>
                            <a target="_blank" href="https://youtube.com/" aria-label="youtube"><i class="fa-brands fa-youtube"></i></a>
                        </div>
                    </div>
                    <div class="rts__footer__widget max-320">
                        <div class="font-20 fw-medium mb-3 h6">Subscribe Our Newsletter</div>
                        <p class="br-sm-none">Subscribe Our Newsletter get <br> Update our New Course</p>
                        <form action="#" class="d-flex align-items-center justify-content-between mt-4 newsletter">
                            <input type="email" name="semail" id="semail" placeholder="Enter your email" required>
                            <button type="submit" class="rts__btn fill__btn">Subscribe</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <div class="rts__copyright">
            <div class="container">
                <p class="text-center fw-medium py-4">Copyright © 2024 All Rights Reserved by jobpath</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/assets/js/plugins.min.js"></script>
    <script src="/assets/js/main.js"></script>
</body>
</html>