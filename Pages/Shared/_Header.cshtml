@model SWP391_M2_BL5_G4_SP25.DTO.HeaderDTO

<header class="rts__section rts__dashboard__header position-fixed w-100">
    <div class="container-fluid g-0">
        <div class="rts__menu__background mw-100 px-20 mobile__padding rounded-0">
            <div class="row">
                <div class="d-flex align-items-center justify-content-between">
                    <div class="rts__logo">
                        @if (!User.IsInRole("Admin"))
                        {
                            <a href="/">
                                <img class="logo__image" src="/assets/img/logo/header__one.svg" width="160" height="40" alt="logo">
                            </a>
                        }
                        else
                        {
                            <a>
                                <img class="logo__image" src="/assets/img/logo/header__one.svg" width="160" height="40" alt="logo">
                            </a>
                        }
                    </div>

                    <div class="navigation d-none d-lg-block">
                        <nav class="navigation__menu" id="offcanvas__menu">
                            <ul class="list-unstyled">
                                @if (!User.IsInRole("Admin"))
                                {
                                    <li class="navigation__menu--item has-child has-arrow">
                                        <a href="#" class="navigation__menu--item__link">Category</a>
                                        <ul class="submenu sub__style" role="menu">
                                            @foreach (var cate in Model.JobCategories)
                                            {
                                                <li role="menuitem"><a href="/Jobs?category=@(cate.JobCategoryID)">@cate.CategoryName</a></li>
                                            }
                                        </ul>
                                    </li>
                                    <li class="navigation__menu--item has-child">
                                        <a href="/Jobs" class="navigation__menu--item__link">Browse Jobs</a>
                                    </li>
                                    <li class="navigation__menu--item has-child">
                                        <a href="/Company" class="navigation__menu--item__link">Company</a>
                                    </li>
                                }
                                
                                @if (User.IsInRole("Client"))
                                {
                                    <li class="navigation__menu--item has-child">
                                        <a href="/Client" class="navigation__menu--item__link">Client</a>
                                    </li>
                                }
                                else if(User.IsInRole("JobSeeker"))
                                {
                                    <li class="navigation__menu--item has-child">
                                        <a href="/JobSeeker" class="navigation__menu--item__link">JobSeeker</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>

                    <div class="rts__menu d-flex gap-5 gap-lg-4 gap-xl-5 align-items-center">

                        <div class="header__right__btn d-flex align-items-center gap-30">
                            
                            @if (User.Identity.IsAuthenticated)
                            {
                                @if (User.IsInRole("Client"))
                                {
                                    <div class="user__info">
                                        <div class="d-flex gap-3 align-items-center pointer" data-bs-toggle="dropdown">
                                            <div class="user__name d-none d-xl-block">
                                                <h6 class="font-20 mb-0 fw-medium lh-sm">@Model.User.FullName</h6>
                                                <span>Client</span>
                                            </div>
                                            <div class="dropdown__option d-none d-xl-block">
                                                <div class="dropdown__icon "><i class="fa-light fa-chevron-down"></i></div>
                                            </div>
                                        </div>
                                        <ul class="rts__dropdown dropdown-menu top-25">
                                            <li><a class="dropdown-item" href="/Client/Profile">Profile</a></li>
                                            <li><a class="dropdown-item" href="/Account/ChangePassword">Change Password</a></li>
                                            <li><a class="dropdown-item" href="/Account/Logout">Log Out</a></li>
                                        </ul>
                                    </div>
                                }
                                else if(User.IsInRole("JobSeeker"))
                                {
                                    <div class="user__info">
                                        <div class="d-flex gap-3 align-items-center pointer" data-bs-toggle="dropdown">
                                            <div class="user__name d-none d-xl-block">
                                                <h6 class="font-20 mb-0 fw-medium lh-sm">@Model.User.FullName</h6>
                                                <span>JobSeeker</span>
                                            </div>
                                            <div class="dropdown__option d-none d-xl-block">
                                                <div class="dropdown__icon "><i class="fa-light fa-chevron-down"></i></div>
                                            </div>
                                        </div>
                                        <ul class="rts__dropdown dropdown-menu top-25">
                                            <li><a class="dropdown-item" href="/JobSeeker">Profile</a></li>
                                            <li><a class="dropdown-item" href="/Account/ChangePassword">Change Password</a></li>
                                            <li><a class="dropdown-item" href="/Account/Logout">Log Out</a></li>
                                        </ul>
                                    </div>
                                }
                                else
                                {
                                    <div class="user__info">
                                        <div class="d-flex gap-3 align-items-center pointer" data-bs-toggle="dropdown">
                                            <div class="user__name d-none d-xl-block">
                                                <h6 class="font-20 mb-0 fw-medium lh-sm">Admin</h6>
                                            </div>
                                            <div class="dropdown__option d-none d-xl-block">
                                                <div class="dropdown__icon "><i class="fa-light fa-chevron-down"></i></div>
                                            </div>
                                        </div>
                                        <ul class="rts__dropdown dropdown-menu top-25">
                                            <li><a class="dropdown-item" href="/Admin">Profile</a></li>
                                            <li><a class="dropdown-item" href="/Account/ChangePassword">Change Password</a></li>
                                            <li><a class="dropdown-item" href="/Account/Logout">Log Out</a></li>
                                        </ul>
                                    </div>
                                }
                            }else{
                                <div class="header__right__btn d-flex gap-3">
                                    <a href="/Account/Login" class="small__btn d-none d-sm-flex no__fill__btn border-6 font-xs" aria-label="Login Button"> <i class="rt-login"></i>Login</a>
                                    <a href="/Account/Register" class="small__btn d-none d-sm-flex no__fill__btn border-6 font-xs" aria-label="Login Button"> Register</a>
                                </div>
                            }
                            
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>