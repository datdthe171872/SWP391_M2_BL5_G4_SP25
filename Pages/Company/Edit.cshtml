								<a href="/employer-dash-jobpost" class="small__btn d-none d-sm-flex d-xl-flex fill__btn border-6 font-xs" aria-label="Job Posting Button">Add Job</a>
								<button class="d-md-block d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvas" aria-controls="offcanvas"><i class="fa-sharp fa-regular fa-bars"></i></button>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</header>

	<!-- Breadcrumb -->
	<div class="rts__section breadcrumb__background">
		<div class="container">
			<div class="row">
				<div class="col-lg-12 position-relative d-flex justify-content-between align-items-center">
					<div class="breadcrumb__area max-content mx-auto breadcrumb__padding">
						<h3 class="text-center h3 mb-0">Browse Companies</h3>
					</div>

					<div class="breadcrumb__area__shape breadcrumb__style__four d-flex gap-4 justify-content-end align-items-center">
						<div class="shape__one common"><img src="/assets/img/breadcrumb/shape-1.svg" alt=""></div>
						<div class="shape__two common"><img src="/assets/img/breadcrumb/shape-2.svg" alt=""></div>
						<div class="shape__three common"><img src="/assets/img/breadcrumb/shape-3.svg" alt=""></div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Company List -->
	<div class="rts__section section__padding">
		<div class="container">
			<form method="post" enctype="multipart/form-data">
				<input type="hidden" asp-for="Input.CompanyID" />
				<input type="hidden" asp-for="Input.ExistingImagePath" />
				<div class="mb-3">
					<label asp-for="Input.CompanyName" class="form-label"></label>
					<input asp-for="Input.CompanyName" class="form-control" />
					<span asp-validation-for="Input.CompanyName" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Input.Email" class="form-label"></label>
					<input asp-for="Input.Email" class="form-control" />
					<span asp-validation-for="Input.Email" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Input.Description" class="form-label"></label>
					<textarea asp-for="Input.Description" class="form-control"></textarea>
					<span asp-validation-for="Input.Description" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Input.Link" class="form-label"></label>
					<input asp-for="Input.Link" class="form-control" />
					<span asp-validation-for="Input.Link" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Input.Location" class="form-label"></label>
					<input asp-for="Input.Location" class="form-control" />
					<span asp-validation-for="Input.Location" class="text-danger"></span>
				</div>

				<div class="mb-3">
					<label asp-for="Input.ImageFile" class="form-label"></label>
					<input asp-for="Input.ImageFile" type="file" class="form-control" />
					<span asp-validation-for="Input.ImageFile" class="text-danger"></span>
					@if (!string.IsNullOrEmpty(Model.Input.ExistingImagePath))
					{
						<div class="mt-2">
							<p><strong>Current Image Path:</strong> @Model.Input.ExistingImagePath</p>
						</div>
					}
				</div>

				<button type="submit" class="btn btn-success">Save Changes</button>
				<a asp-page="CompanyList" class="btn btn-secondary">Cancel</a>
			</form>

		</div>
	</div>

	<!-- Footer -->
