														<li role="menuitem"><a href="/candidate-1">Candidate One</a></li>
														<li role="menuitem"><a href="/candidate-2">Candidate Two</a></li>
														<li role="menuitem"><a href="/candidate-3">Candidate Three</a></li>
														<li role="menuitem"><a href="/candidate-4">Candidate Four</a></li>
													</ul>
												</li>
												<li role="menuitem" class="has-child has-arrow">
													<a href="/candidate-details-1">Candidate Details</a>
													<ul class="sub__style" role="menu">
														<li role="menuitem"><a href="/candidate-details-1">Candidate Details 1</a></li>
														<li role="menuitem"><a href="/candidate-details-2">Candidate Details 2</a></li>
													</ul>
												</li>
												<li role="menuitem"><a href="/candidate-dashboard">Candidate Dashboard</a></li>
