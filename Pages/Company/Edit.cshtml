@page "/Client/EditCompany"
@model SWP391_M2_BL5_G4_SP25.Pages.Company.EditModel
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Browse Companies">
    <meta name="keywords" content="Companies, Jobpath">
    <link rel="shortcut-icon" href="/assets/img/favicon-16x16.png" type="image/x-icon">
    <title>@ViewData["Title"] - Jobpath</title>
    <link rel="stylesheet" href="/assets/fonts/icon/css/rt-icons.css">
    <link rel="stylesheet" href="/assets/fonts/fontawesome/fontawesome.min.css">
    <link rel="stylesheet" href="/assets/css/plugins.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="template-dashboard">
    <!-- Header -->
    @await Html.PartialAsync("_Header", Model.Header)
    <!-- content area -->
    <div class="dashboard__content d-flex">
        @await Html.PartialAsync("_NavClient")
        <div class="dashboard__right">
            <div class="dash__content ">
                <!-- sidebar menu -->
                <div class="sidebar__menu d-md-block d-lg-none">
                    <div class="sidebar__action"><i class="fa-sharp fa-regular fa-bars"></i> Sidebar</div>
                </div>
                <!-- sidebar menu end -->

                <div class="my__profile__tab radius-16 bg-white">
                    <nav>
                        <div class="nav nav-tabs">
                            <a class="nav-link active" href="#info"> Create Company</a>
                        </div>
                    </nav>
                    <div class="my__details" id="info">
                        @* <div class="info__top">
                        <div class="author__image">
                        <img class="p-4" src="assets/img/icon/google.svg" alt="">
                        </div>
                        <div class="select__image">
                        <label for="file" class="file-upload__label">Upload New Photo</label>
                        <input type="file" class="file-upload__input" id="file" required>
                        </div>
                        <div class="delete__data">
                        <i class="fa-light fa-trash-can"></i>
                        </div>
                        </div> *@
                        <br />
                        <br />
                        <div class="info__field">
                            <form method="post" enctype="multipart/form-data">
                                <input type="hidden" asp-for="Input.CompanyID" />
                                <input type="hidden" asp-for="Input.ExistingImagePath" />
                                <div class="mb-3">
                                    <label asp-for="Input.CompanyName" class="form-label"></label>
                                    <input asp-for="Input.CompanyName" class="form-control" />
                                    <span asp-validation-for="Input.CompanyName" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.Email" class="form-label"></label>
                                    <input asp-for="Input.Email" class="form-control" />
                                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.Description" class="form-label"></label>
                                    <textarea asp-for="Input.Description" class="form-control"></textarea>
                                    <span asp-validation-for="Input.Description" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.Link" class="form-label"></label>
                                    <input asp-for="Input.Link" class="form-control" />
                                    <span asp-validation-for="Input.Link" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.Location" class="form-label"></label>
                                    <input asp-for="Input.Location" class="form-control" />
                                    <span asp-validation-for="Input.Location" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Input.ImageFile" class="form-label"></label>
                                    <input asp-for="Input.ImageFile" type="file" class="form-control" />
                                    <span asp-validation-for="Input.ImageFile" class="text-danger"></span>
                                    @if (!string.IsNullOrEmpty(Model.Input.ExistingImagePath))
                                    {
                                        <div class="mt-2">
                                            <p><strong>Current Image Path:</strong> @Model.Input.ExistingImagePath</p>
                                        </div>
                                    }
                                </div>

                                <button type="submit" class="btn btn-success">Save Changes</button>
                                <a asp-page="CompanyList" class="btn btn-secondary">Cancel</a>
                            </form>
                            <!-- editor area -->
                            <div class="rt-input-group">
                                <div class="textarea"></div>
                            </div>
                            <!-- editor area end -->
                        </div>
                    </div>
                </div>


            </div>
            <div class="d-flex justify-content-center mt-30">
                <p class="copyright">Copyright © 2024 All Rights Reserved by jobpath</p>

            </div>
        </div>
    </div>
    <!-- content area end -->
    <!-- THEME PRELOADER START -->
    <div class="loader-wrapper">
        <div class="loader">
        </div>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
    </div>
    <!-- THEME PRELOADER END -->
    <button type="button" class="rts__back__top" id="rts-back-to-top">
        <i class="fas fa-arrow-up"></i>
    </button>
    <!-- Company List -->
    <div class="rts__section section__padding">
        <div class="container">
        </div>
    </div>



    <!-- Scripts -->
    <script src="/assets/js/plugins.min.js"></script>
    <script src="/assets/js/main.js"></script>
    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>