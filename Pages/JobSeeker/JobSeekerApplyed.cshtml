@page "/JobSeeker/AppliedJob"
@model SWP391_M2_BL5_G4_SP25.Pages.JobSeeker.JobSeekerApplyedModel
@{
    ViewData["Title"] = "Applied Jobs";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="Your Ultimate Job HTML Template">
    <meta name="keywords" content="Job, Resume, Employer, Agency">
    <link rel="canonical" href="https://html.themewant.com/jobpath">
    <meta name="robots" content="index, follow">
    <!-- Open Graph -->
    <meta property="og:title" content="Your Ultimate Job HTML Template">
    <meta property="og:description" content="Your Ultimate Job HTML Template">
    <meta property="og:image" content="https://www.example.com/image.html">
    <meta property="og:url" content="https://html.themewant.com/jobpath/">
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Your Ultimate Job HTML Template">
    <meta name="twitter:description" content="Your Ultimate Job HTML Template">
    <!-- Favicon -->
    <link rel="shortcut-icon" href="/assets/img/favicon-16x16.png" type="image/x-icon">
    <link rel="shortcut icon" href="/assets/img/favicon.ico" type="image/x-icon">
    <title>Jobpath - Job Seeker & Job Holder HTML Template</title>
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@200..800&display=swap" rel="stylesheet">
    <!-- Icons -->
    <link rel="stylesheet" href="/assets/fonts/icon/css/rt-icons.css">
    <link rel="stylesheet" href="/assets/fonts/fontawesome/fontawesome.min.css">
    <!-- CSS -->
    <link rel="stylesheet" href="/assets/css/plugins.min.css">
    <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="template-dashboard">
    <!-- Header -->
    @await Html.PartialAsync("_Header",Model.Header)

    <!-- Content Area -->
    <div class="dashboard__content d-flex">
        @await Html.PartialAsync("_NavSeeker")
                            Change Password
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="candidate-deleteprofile.html" class="nav-link">
                            <svg width="20" height="21" viewBox="0 0 20 21" fill="none" xmlns="http://www.w3.org/2000/svg"></svg>
                            Delete Profile
                        </a>
                    </li>
                </ul>
            </div>
            <div class="dash__logout">
                <figure class="logout__image">
                    <img src="assets/img/dashboard/logout.png" alt="Logout">
                </figure>
                <a class="logout__btn" href="#"><i class="rt-login"></i> Logout</a>
            </div>
        </div>
        <div class="dashboard__right">
            <h1 style="margin-bottom: 20px;" >Job Applied</h1>
            <div class="dash__content">
                <!-- Sidebar Menu -->
                <div class="sidebar__menu d-md-block d-lg-none">
                    <div class="sidebar__action"><i class="fa-sharp fa-regular fa-bars"></i> Sidebar</div>
                </div>
                <!-- Sidebar Menu End -->

                <div class="applied__job__info radius-16">
                    <div class="job__filter">
                        <div class="search__job">
                            <form asp-page="/a" method="get">
                                <div class="position-relative">
                                    <input type="text" id="search" name="searchTerm" value="@Model.SearchTerm" placeholder="Find Top Employer" />
                                    <i class="fa-light fa-magnifying-glass"></i>
                                </div>
                            </form>
                        </div>
                        <div class="filter__job">
                            <form asp-page="/a" method="get">
                                <select name="categoryFilter" onchange="this.form.submit()">
                                    <option value="All Category" selected="@(Model.CategoryFilter == "All Category")">All Category</option>
                                    <option value="@SWP391_M2_BL5_G4_SP25.Constants.JoptypeOption.FULL_TIME" selected="@(Model.CategoryFilter == SWP391_M2_BL5_G4_SP25.Constants.JoptypeOption.FULL_TIME)">Full Time</option>
                                    <option value="@SWP391_M2_BL5_G4_SP25.Constants.JoptypeOption.PART_TIME" selected="@(Model.CategoryFilter == SWP391_M2_BL5_G4_SP25.Constants.JoptypeOption.PART_TIME)">Part Time</option>
                                </select>
                            </form>
                        </div>
                    </div>

                    <div class="applied__job__list">
                        @if (Model.AppliedJobs.Any())
                        {
                            foreach (var job in Model.AppliedJobs)
                            {
                                <div class="single__applied__job">
                                    <div class="single__applied__job__content">
                                        <div class="icon">
                                            <img src="@job.CompanyLogo" alt="@job.CompanyName" onerror="this.src='/assets/img/home-1/company/amazon.svg'" />
                                        </div>
                                        <div class="content__flex">
                                            <div class="content">
                                                <a href="/Jobs/Details?JobId=@job.JobID"><h6>@job.JobTitle, @job.CompanyName</h6></a>
                                                <div class="content__info">
                                                    <span><i class="fa-light fa-location-dot"></i> @job.Location</span>
                                                    <span><i class="fa-light fa-briefcase"></i> @job.JobType</span>
                                                    <span><i class="fa-light fa-clock"></i> @job.ApplicationDate.ToString("MMM dd, yyyy")</span>
                                                </div>
                                            </div>
                                            <div class="tags">
                                                @foreach (var skill in job.SkillsRequired)
                                                {
                                                    <a href="#"><span class="tag">@skill.Trim()</span></a>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                    <div class="action">
                                       
                                        <button class="action__btn" title="View Application" data-bs-toggle="modal" data-bs-target="#viewCVModal_@job.JobApplicationID">
                                            <svg width="22" height="16" viewBox="0 0 22 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                <path d="M20.544 7.045C20.848 7.471 21 7.685 21 8C21 8.316 20.848 8.529 20.544 8.955C19.178 10.871 15.689 15 11 15C6.31 15 2.822 10.87 1.456 8.955C1.152 8.529 1 8.315 1 8C1 7.684 1.152 7.471 1.456 7.045C2.822 5.129 6.311 1 11 1C15.69 1 19.178 5.13 20.544 7.045Z" stroke="#0B0D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                                <path d="M14 8C14 7.20435 13.6839 6.44129 13.1213 5.87868C12.5587 5.31607 11.7956 5 11 5C10.2044 5 9.44129 5.31607 8.87868 5.87868C8.31607 6.44129 8 7.20435 8 8C8 8.79565 8.31607 9.55871 8.87868 10.1213C9.44129 10.6839 10.2044 11 11 11C11.7956 11 12.5587 10.6839 13.1213 10.1213C13.6839 9.55871 14 8.79565 14 8Z" stroke="#0B0D28" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                                            </svg>
                                        </button>
                                        
                                        <button class="action__operation @job.Status.ToLower()">
                                            @job.Status
                                        </button>
                                    </div>
                                </div>

                                <!-- Modal to View CV -->
                                <div class="modal fade" id="viewCVModal_@job.JobApplicationID" tabindex="-1" aria-labelledby="viewCVModalLabel_@job.JobApplicationID" aria-hidden="true">
                                    <div class="modal-dialog modal-lg">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="viewCVModalLabel_@job.JobApplicationID">View CV for @job.JobTitle</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                @if (!string.IsNullOrEmpty(job.CVFile))
                                                {
                                                    <p><strong>CV File:</strong> <a href="@job.CVFile" target="_blank" download>Download CV</a></p>
                                                    <!-- Embed PDF viewer if CV is a PDF -->
                                                    <embed src="@job.CVFile" type="application/pdf" width="100%" height="500px" />
                                                }
                                                else
                                                {
                                                    <p>No CV file available for this application.</p>
                                                }
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p>No applied jobs found.</p>
                        }
                    </div>

                    @* <!-- Pagination -->
                    @if (Model.TotalPages > 1)
                    {
                        <div class="rts__pagination d-block mx-auto pt-40 max-content">
                            <ul class="d-flex gap-2">
                                <li>
                                    <a href="@Url.Page("/JobSeeker/AppliedJob", new { searchTerm = Model.SearchTerm, categoryFilter = Model.CategoryFilter, pageIndex = Model.PageIndex - 1 })" class="@(Model.PageIndex == 1 ? "inactive" : "")">
                                        <i class="rt-chevron-left"></i>
                                    </a>
                                </li>
                                @for (int i = 1; i <= Model.TotalPages; i++)
                                {
                                    <li>
                                        <a href="@Url.Page("/JobSeeker/AppliedJob", new { searchTerm = Model.SearchTerm, categoryFilter = Model.CategoryFilter, pageIndex = i })" class="@(Model.PageIndex == i ? "active" : "")">@i</a>
                                    </li>
                                }
                                <li>
                                    <a href="@Url.Page("/JobSeeker/AppliedJob", new { searchTerm = Model.SearchTerm, categoryFilter = Model.CategoryFilter, pageIndex = Model.PageIndex + 1 })" class="@(Model.PageIndex == Model.TotalPages ? "inactive" : "")">
                                        <i class="rt-chevron-right"></i>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    } *@
                </div>

                <div class="d-flex justify-content-center mt-30">
                    <p class="copyright">Copyright © 2024 All Rights Reserved by jobpath</p>
                </div>
            </div>
        </div>
    </div>
    <!-- Content Area End -->
    <!-- Offcanvas -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvas" aria-labelledby="offcanvasLabel">
        <div class="offcanvas-header p-0 mb-5 mt-4">
            <a href="index-2.html" class="offcanvas-title" id="offcanvasLabel">
                <img src="/assets/img/logo/header__one.svg" alt="logo">
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="mb-4 d-block d-sm-none">
            <div class="header__right__btn d-flex justify-content-center gap-3">
                <a href="#" class="small__btn no__fill__btn border-6 font-xs" aria-label="Login Button" data-bs-toggle="modal" data-bs-target="#loginModal">
                    <i class="rt-login"></i>Sign In
                </a>
                <a href="#" class="small__btn d-xl-flex fill__btn border-6 font-xs" aria-label="Job Posting Button">Add Job</a>
            </div>
        </div>
        <div class="offcanvas-body p-0">
            <div class="rts__offcanvas__menu overflow-hidden">
                <div class="offcanvas__menu"></div>
            </div>
            <p class="max-auto font-20 fw-medium text-center text-decoration-underline mt-4">Our Social Links</p>
            <div class="rts__social d-flex justify-content-center gap-3 mt-3">
                <a target="_blank" href="https://facebook.com/" aria-label="facebook"><i class="fa-brands fa-facebook"></i></a>
                <a target="_blank" href="https://instagram.com/" aria-label="instagram"><i class="fa-brands fa-instagram"></i></a>
                <a target="_blank" href="https://linkedin.com/" aria-label="linkedin"><i class="fa-brands fa-linkedin"></i></a>
                <a target="_blank" href="https://pinterest.com/" aria-label="pinterest"><i class="fa-brands fa-pinterest"></i></a>
                <a target="_blank" href="https://youtube.com/" aria-label="youtube"><i class="fa-brands fa-youtube"></i></a>
            </div>
        </div>
    </div>

    <!-- Preloader -->
    <div class="loader-wrapper">
        <div class="loader"></div>
        <div class="loader-section section-left"></div>
        <div class="loader-section section-right"></div>
    </div>

    <!-- Back to Top -->
    <button type="button" class="rts__back__top" id="rts-back-to-top">
        <i class="fas fa-arrow-up"></i>
    </button>

    <!-- Scripts -->
    <script src="/assets/js/plugins.min.js"></script>
    <script src="/assets/js/main.js"></script>
</body>
</html>